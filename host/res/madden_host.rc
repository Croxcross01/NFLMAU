#include <winuser.h>
1 RT_MANIFEST "madden_host.manifest"
1 ICON "../../launcher-win/art/app.ico"
1 VERSIONINFO
FILEVERSION 1,0,18,0
PRODUCTVERSION 1,0,18,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Madden Arcade Unleashed project (github.com/Croxcross01/NFLMAU)"
      VALUE "FileDescription", "Madden Arcade Unleashed game (built on this PC)"
      VALUE "FileVersion", "1.0.18"
      VALUE "InternalName", "madden_host.exe"
      VALUE "LegalCopyright", "Open-source fan project. Not affiliated with EA or Microsoft."
      VALUE "OriginalFilename", "madden_host.exe"
      VALUE "ProductName", "Madden Arcade Unleashed"
      VALUE "ProductVersion", "1.0.18"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
