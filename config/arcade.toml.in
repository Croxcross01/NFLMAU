# ---- mod support hooks (Madden Arcade PC) ----
# Uniform art lookup (sub_886A95E0): the descriptor's team id (offset 8) selects the TEAM/TUNI rows the uniform
# asset names come from. Teams added by mods (ids beyond the 32 NFL teams) are remapped to the team whose art they use.
[[midasm_hook]]
name = "ModArtTeamRemap"
address = 0x886A95EC
registers = ["r1", "r4", "r29"]

# Database queries (sub_88DCBAE0: r6 = query text, r7.. = arguments). Queries on art/presentation tables with a mod
# team's id are redirected to the team whose art it uses (identity/roster tables are never redirected).
[[midasm_hook]]
name = "ModDbQuery"
address = 0x88DCBAE0
registers = ["r1", "r6", "r7", "r8", "r9", "r10"]

# Material texture binding (sub_88EBFAEC): a slot whose texture object is invalid (mod teams) is treated as empty.
[[midasm_hook]]
name = "ModTextureGuard"
address = 0x88EBFBC0
registers = ["r1", "r3", "r24", "r30"]
jump_address_on_true = 0x88EBFBAC

# Match team setup (sub_88BFE630): log the error code when it stops early.
[[midasm_hook]]
name = "ModTeamSetupFail"
address = 0x88BFEC30
registers = ["r31"]

[[midasm_hook]]
name = "ModTeamRenumber"
address = 0x88BEB850
registers = ["r3", "r4", "r5", "r6", "r7"]

# Reference-counted release: skip handles that do not point at a game object (mid-game crash fix).
[[midasm_hook]]
name = "GuardRelease"
address = 0x88310450
registers = ["r1", "r3"]
return_on_true = true

[[midasm_hook]]
name = "GuardReleaseInline"
address = 0x886B277C
registers = ["r1", "r11", "r26", "r30", "r31"]
jump_address_on_true = 0x886B27B8

# Match setup (sub_882E30B0): log both team ids and roster file names.
[[midasm_hook]]
name = "ModMatchTeams"
address = 0x882E31BC
registers = ["r1", "r31"]

# Resource name hash (debug: log looked-up resource names).
[[midasm_hook]]
name = "ModNameHash"
address = 0x89027BC0
registers = ["r3"]

# Visual component set-model (invisible players): a non-object model is stored as none and logged.
[[midasm_hook]]
name = "GuardSetModel"
address = 0x88394060
registers = ["r1", "r3", "r4"]

[[midasm_hook]]
name = "ModTeamModels"
address = 0x886BAE98
registers = ["r4"]

[[midasm_hook]]
name = "ModModelLookupFail"
address = 0x886B2EA8
registers = ["r8", "r31"]

[[midasm_hook]]
name = "ModPlayerInfo"
address = 0x886B2E48
registers = ["r4"]

[[midasm_hook]]
name = "ModPlayerLoad"
address = 0x886ACD30
registers = ["r1", "r3", "r4", "r5"]

[[midasm_hook]]
name = "ModPlaybookState"
address = 0x88535578
registers = ["r3", "r4", "r5"]

# After the match depth charts are copied (sub_88BF51D8): build depth charts for match teams that have none.
[[midasm_hook]]
name = "ModBuildDepthCharts"
address = 0x88BF5400

# Own uniforms for mod teams (teams.ini "100=13,HOF"): the uniform prefix (TEAM.TPFN) is replaced right after each read.
[[midasm_hook]]
name = "ModPrefixUniform"
address = 0x886A965C
registers = ["r31"]

[[midasm_hook]]
name = "ModPrefixMixList"
address = 0x886A9D1C
registers = ["r1", "r30"]

[[midasm_hook]]
name = "ModPrefixSetup"
address = 0x886BE48C
registers = ["r29", "r30"]

# Debug: swappable UI images (library, item) as they are drawn
[[midasm_hook]]
name = "ModSwapImage"
address = 0x88D6CD50
registers = ["r3"]

# Lineup picker: while its window is open, the loading-screen UI update (sub_88DDF730) is paused (the game's UI touched
# freed menu objects when the match setup was held up for a long time on the 2nd match).
[[midasm_hook]]
name = "ModUiUpdateGate"
address = 0x88DDF74C
jump_address_on_true = 0x88DDF838

# 7-on-7 research: the game-changer roll result (r30, written to the power-up slot right here). Logged, and can be
# forced from mods/force_powerup.txt to find which value is Entourage ("sends the rest of your linemen into the game").
[[midasm_hook]]
name = "ModPowerupRoll"
address = 0x88717DE4
registers = ["r29", "r30"]

# Lines mode (mods/lines.txt = 7 or full): Entourage's "bring in the linemen" step (sub_8871B230) is run once every
# down without the power-up. Trigger: the team's power-up slot reads 9 (Entourage) for that one pass; restore: the
# real power-up is put back after the game marks the slot used; filter: in 7-on-7 only LG/RG (offense) and LE/RE
# (defense) are brought in.
[[midasm_hook]]
name = "ModLinesTrigger"
address = 0x8871B47C
registers = ["r11", "r27"]

[[midasm_hook]]
name = "ModLinesRestore"
address = 0x8871B4AC
registers = ["r9", "r27"]

[[midasm_hook]]
name = "ModLinesFilter"
address = 0x8871B52C
registers = ["r3", "r11", "r15", "r27", "r30", "r31"]
jump_address_on_true = 0x8871B550

# Lines mode: a play pick rebuilds the formation (dropping the extra linemen): re-run the linemen step after each pick.
[[midasm_hook]]
name = "ModLinesOffensePicked"
address = 0x8859017C

[[midasm_hook]]
name = "ModLinesDefensePicked"
address = 0x885901F4

# per-frame tick of the game-changer update (sub_8871B230): schedules the re-runs after a pick
[[midasm_hook]]
name = "ModLinesTick"
address = 0x8871B26C

# Lines mode filter for the defense path of the same step (the defense jumps past ModLinesFilter to here).
[[midasm_hook]]
name = "ModLinesFilterDefense"
address = 0x8871B53C
registers = ["r3", "r11", "r15", "r27", "r30", "r31"]
jump_address_on_true = 0x8871B550

# Lines mode: the game's "can this power-up be used now" check (sub_887175C8) sometimes refuses the step for a team
# holding another power-up; for the step lines mode asked for, its answer is ignored.
[[midasm_hook]]
name = "ModLinesCanUse"
address = 0x8871B490
registers = ["r3", "r27"]


# Full play-call screen: the two "set this team's play by formation / play name" calls (sub_88834460) in the step that
# sets each down's plays (sub_8871BFD0): offense first, then defense. r5 / r6 = formation / play name.
[[midasm_hook]]
name = "PlayCallOffense"
address = 0x8871C1F4
registers = ["r4", "r5", "r6"]

[[midasm_hook]]
name = "PlayCallDefense"
address = 0x8871C23C
registers = ["r4", "r5", "r6"]

# Full playbook: who controls the offense / defense this down (r3 = user index, 255 = CPU; r26 = play-call state;
# the defense is only asked when the offense is the CPU), and the per-frame check of the two "called" flags.
[[midasm_hook]]
name = "PlayCallWhoOffense"
address = 0x8871C064
registers = ["r3", "r26"]

[[midasm_hook]]
name = "PlayCallWhoDefense"
address = 0x8871C094
registers = ["r3", "r26"]

[[midasm_hook]]
name = "PlayCallCommit"
address = 0x8871C16C
registers = ["r26"]

# Pass study (temporary): receiver for a pass icon (r4 = icon index 0..4).
[[midasm_hook]]
name = "PassIconLog"
address = 0x88535D70
registers = ["r1", "r4"]

[[midasm_hook]]
name = "PassFn_8844C7D8"
address = 0x8844C7D8
registers = ["r1", "r3", "r4"]

[[midasm_hook]]
name = "PassFn_8844C840"
address = 0x8844C840
registers = ["r1", "r3", "r4"]

[[midasm_hook]]
name = "PassFn_88456C98"
address = 0x88456C98
registers = ["r1", "r3", "r4"]

[[midasm_hook]]
name = "PassFn_88457AE8"
address = 0x88457AE8
registers = ["r1", "r3", "r4"]

[[midasm_hook]]
name = "PassFn_884738A0"
address = 0x884738A0
registers = ["r1", "r3", "r4"]

[[midasm_hook]]
name = "PassFn_88536EE0"
address = 0x88536EE0
registers = ["r1", "r3", "r4"]

[[midasm_hook]]
name = "PassIconSlot"
address = 0x88496134
registers = ["r29", "r31"]

[[midasm_hook]]
name = "PassIconButton"
address = 0x88496180
registers = ["r3", "r30", "r31"]

# Pass icons: the "is this icon slot hidden" answer in the icon drawer (r3), forced to shown; r30 = icon slot.
[[midasm_hook]]
name = "PassIconShown"
address = 0x884961A8
registers = ["r3", "r30"]

# Pass icons study: picture chosen for an icon slot (r3 after sub_8844C850), r30 = icon slot.
[[midasm_hook]]
name = "PassIconGlyph"
address = 0x88496200
registers = ["r3", "r30"]

# Pass icons study: raw button bound to an icon slot's pass action (r3), r29 = slot.
[[midasm_hook]]
name = "PassIconCode"
address = 0x8844C8AC
registers = ["r3", "r29"]

# Pass icons per play: where the icon drawer reads a slot's kept picture (r28 = drawer, r30 = slot).
[[midasm_hook]]
name = "PassIconCache"
address = 0x884961C8
registers = ["r28", "r30"]

# Play action for the user: after each play step is fetched from the playbook (code at r1+96, values +98/+99/+100).
[[midasm_hook]]
name = "PaStepFetched"
address = 0x884479B4
registers = ["r1"]

# Play action for the user: the play call's own step loader (sub_88519F48), after each step row is fetched.
[[midasm_hook]]
name = "PaStepFetched2"
address = 0x8851A158
registers = ["r1"]
