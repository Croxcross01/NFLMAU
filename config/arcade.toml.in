# XenonRecomp config for Madden NFL Arcade (XBLA), Arcadegame.dll SHA-1 b4e72f27effceee64734d365ed9bb214b0772633
# Addresses only - no game code. setup.py fills in the @...@ paths.
[main]
file_path = "@IMAGE_SOURCE@"
out_directory_path = "@OUT_DIR@"
switch_table_file_path = "@SWITCH_TABLES@"

restgprlr_14_address = 0x890ACE30
savegprlr_14_address = 0x890ACDE0
restfpr_14_address = 0x890AD6EC
savefpr_14_address = 0x890AD6A0
restvmx_14_address = 0x890AE3A8
savevmx_14_address = 0x890AE110
restvmx_64_address = 0x890AE43C
savevmx_64_address = 0x890AE1A4

