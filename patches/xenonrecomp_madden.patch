+    // Extra entry points: code that other functions branch into (compiler tail-merging). Each gets its own
+    // standalone function so the branch can become a call; the containing function is left untouched.
+    for (uint32_t address : config.entryPoints)
+    {
+        auto sym = image.symbols.find(address);
+        if (sym != image.symbols.end() && sym->address == address) continue;
+        for (const auto& section : image.sections)
+        {
+            if (!(section.flags & SectionFlags_Code) || address < section.base || address >= section.base + section.size) continue;
+            auto data = section.data + (address - section.base);
+            // Simple extent scan (the stock analyser can loop forever on blocks that branch back before their start):
+            // walk forward, track the farthest forward branch target, stop at an unconditional exit past it.
+            Function f{ address, 0 };
+            {
+                size_t limit = section.base + section.size, farthest = address, p = address;
+                for (; p + 4 <= limit && p - address < 0x10000; p += 4)
+                {
+                    uint32_t w = ByteSwap(*(uint32_t*)(section.data + (p - section.base)));
+                    uint32_t op = w >> 26;
+                    bool link = w & 1;
+                    if (op == 16 && !link)                    // bc
+                    {
+                        int32_t bd = (int16_t)(w & 0xFFFC);
+                        size_t t = p + bd; if (t > farthest) farthest = t;
+                        if (((w >> 21) & 0x14) == 0x14 && p >= farthest) { p += 4; break; }   // "branch always"
+                    }
+                    else if (op == 18 && !link)               // b
+                    {
+                        int32_t li = (int32_t)((w & 0x03FFFFFC) << 6) >> 6;
+                        size_t t = p + li;
+                        if (t > p && t > farthest && t - address < 0x10000 && t < limit) farthest = t;   // forward jump inside the block: keep going
+                        else if (p >= farthest) { p += 4; break; }
+                    }
+                    else if (w == 0x4E800420)                 // bctr: a known jump table keeps the block going
+                    {
+                        bool isSwitch = false;
+                        for (size_t k = p - 12; k <= p; k += 4)
+                        {
+                            auto st = config.switchTables.find(k);
+                            if (st != config.switchTables.end())
+                            {
+                                isSwitch = true;
+                                for (auto l : st->second.labels) if (l > farthest && l - address < 0x10000) farthest = l;
+                            }
+                        }
+                        if (!isSwitch && p >= farthest) { p += 4; break; }
+                    }
+                    else if (w == 0x4E800020 && p >= farthest) { p += 4; break; }   // blr
+                    else if (w == 0) { break; }
+                }
+                f.size = p - address;
+            }
+            if (getenv("XR_DEBUG_ENTRIES")) fmt::println("entry {:X} -> size {:X}", address, f.size);
+            if (f.size == 0) { fmt::println("WARNING: entry point {:X} analysed to an empty function, skipped", address); continue; }
+            auto& fn = functions.emplace_back(f);
+            image.symbols.emplace(fmt::format("sub_{:X}", fn.base), fn.base, fn.size, Symbol_Function);
+        }
+    }
